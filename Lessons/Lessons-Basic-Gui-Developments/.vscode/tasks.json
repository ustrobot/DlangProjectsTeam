{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "dub: debug",
            "command": "dub",
            "args": [
                "build",
                "--build=debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                {
                    "owner": "d",
                    "fileLocation": "relative",
                    "pattern": {
                        "regexp": "^(.+)\\((\\d+)\\): (.*)$",
                        "file": 1,
                        "line": 2,
                        "message": 3
                    }
                }
            ]
        }
    ]
}
